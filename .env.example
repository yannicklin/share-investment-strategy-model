# OCI Configuration
OCI_REGION=ap-sydney-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaa...
OCI_BUCKET_NAME=trading-bot-backups

# Secrets (Optional if using OCI Vault)
OCI_SECRET_ID_DATABASE_URL=
OCI_SECRET_ID_TELEGRAM_BOT_TOKEN=
OCI_SECRET_ID_CRON_TOKEN=

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=generate_a_strong_secret_key_here

# Cloudflare Tunnel Token (Required for remote access)
# Get this from Cloudflare Zero Trust Dashboard -> Access -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
