{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Dashboard",
            "type": "shell",
            "command": "make run",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Stop Dashboard",
            "type": "shell",
            "command": "lsof -ti:8502 | xargs kill -9 2>/dev/null || echo 'Not running'",
            "problemMatcher": []
        },
        {
            "label": "Sync with GitHub",
            "type": "shell",
            "command": "git pull",
            "problemMatcher": []
        }
    ]
}
